# Covet environment variables.
# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# --- Database (Prisma, MySQL) ---
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/covetecom"

# --- Auth.js / NextAuth v5 ---
# Encrypts the session cookie. Generate with: npx auth secret
# Must NOT be an empty string: "" is treated as set and sign-in fails with MissingSecret.
AUTH_SECRET=""

# Needed when running a production build (next start / deploy); without one of these,
# Auth.js rejects requests with UntrustedHost. Not needed for `npm run dev`.
# AUTH_URL must match the real origin (scheme + host + port).
# AUTH_TRUST_HOST=true
# AUTH_URL="http://localhost:3000"

# --- Admin seed (npx prisma db seed) ---
ADMIN_EMAIL="admin@covet.local"
# At least 12 characters. Leave empty in development to generate a random password
# (printed once by the seed). Required in production.
ADMIN_PASSWORD=""
